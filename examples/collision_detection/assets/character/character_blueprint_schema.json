{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CharacterBlueprint",
  "type": "object",
  "properties": {
    "colliders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ColliderConfig"
      }
    },
    "joints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/JointConfig"
      }
    },
    "particles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParticleConfig"
      }
    }
  },
  "required": [
    "colliders",
    "particles",
    "joints"
  ],
  "$defs": {
    "ColliderConfig": {
      "type": "object",
      "properties": {
        "collision": {
          "$ref": "#/$defs/CollisionConstraintConfig"
        },
        "path_id": {
          "type": "string"
        },
        "softbody": {
          "$ref": "#/$defs/SoftBodyInitConfig"
        },
        "svg_id": {
          "type": "string"
        }
      },
      "required": [
        "svg_id",
        "path_id",
        "softbody",
        "collision"
      ]
    },
    "CollisionConstraintConfig": {
      "type": "object",
      "properties": {
        "friction_compliance_scaler": {
          "type": "number",
          "format": "float"
        },
        "pull_compliance_scaler": {
          "type": "number",
          "format": "float"
        },
        "push_compliance_penetration_scaler": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "push_compliance_penetration_scaler",
        "friction_compliance_scaler",
        "pull_compliance_scaler"
      ]
    },
    "ConnectionInitConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Bilinear": {
              "type": "array",
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Bilinear"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Distance": {
              "type": "array",
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Distance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Angular": {
              "type": "array",
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Angular"
          ]
        }
      ]
    },
    "JointConfig": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/$defs/ConnectionInitConfig"
        },
        "path_id": {
          "type": "string"
        },
        "svg_id": {
          "type": "string"
        }
      },
      "required": [
        "svg_id",
        "path_id",
        "config"
      ]
    },
    "Particle": {
      "type": "object",
      "properties": {
        "inv_mass": {
          "type": "number",
          "format": "float"
        },
        "pos": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "pos",
        "inv_mass"
      ]
    },
    "ParticleConfig": {
      "type": "object",
      "properties": {
        "particle": {
          "$ref": "#/$defs/Particle"
        },
        "path_id": {
          "type": "string"
        },
        "svg_id": {
          "type": "string"
        }
      },
      "required": [
        "svg_id",
        "path_id",
        "particle"
      ]
    },
    "SoftBodyInitConfig": {
      "type": "object",
      "properties": {
        "frame_constraints_scaler": {
          "type": "number",
          "format": "float"
        },
        "inner_constraints_scaler": {
          "type": "number",
          "format": "float"
        },
        "max_complexity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "resititution": {
          "type": "number",
          "format": "float"
        },
        "self_collision_complaince": {
          "type": "number",
          "format": "float"
        },
        "self_collision_distance_threhold": {
          "type": "number",
          "format": "float"
        },
        "shape_matching_damping": {
          "type": "number",
          "format": "float"
        },
        "substeps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total_inv_mass": {
          "type": "number",
          "format": "float"
        },
        "velocity_against_nromal_damping_threhold": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "max_complexity",
        "resititution",
        "velocity_against_nromal_damping_threhold",
        "total_inv_mass",
        "inner_constraints_scaler",
        "frame_constraints_scaler",
        "substeps",
        "self_collision_complaince",
        "self_collision_distance_threhold",
        "shape_matching_damping"
      ]
    }
  }
}