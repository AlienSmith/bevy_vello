{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CharacterBlueprint",
  "type": "object",
  "properties": {
    "colliders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ColliderConfig"
      }
    },
    "decorations": {
      "description": "Cosmetic decorations riding body-part frames. Defaults to empty so older\nblueprints without a `decorations` field still deserialize.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Decoration"
      }
    },
    "frame": {
      "$ref": "#/$defs/ShapeMatchingConfig"
    },
    "joints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/JointConfig"
      }
    },
    "particles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParticleConfig"
      }
    }
  },
  "required": [
    "frame",
    "colliders",
    "particles",
    "joints"
  ],
  "$defs": {
    "ColliderConfig": {
      "type": "object",
      "properties": {
        "collision": {
          "$ref": "#/$defs/CollisionConstraintConfig"
        },
        "path_id": {
          "type": "string"
        },
        "softbody": {
          "$ref": "#/$defs/SoftBodyInitConfig"
        },
        "svg_id": {
          "type": "string"
        }
      },
      "required": [
        "svg_id",
        "path_id",
        "softbody",
        "collision"
      ]
    },
    "CollisionConstraintConfig": {
      "type": "object",
      "properties": {
        "friction_compliance_scaler": {
          "type": "number",
          "format": "float"
        },
        "pull_compliance_scaler": {
          "type": "number",
          "format": "float"
        },
        "push_compliance_penetration_scaler": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "push_compliance_penetration_scaler",
        "friction_compliance_scaler",
        "pull_compliance_scaler"
      ]
    },
    "ConnectionInitConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Bilinear": {
              "type": "array",
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                },
                {
                  "type": [
                    "array",
                    "null"
                  ],
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number",
                      "format": "float"
                    },
                    {
                      "type": "number",
                      "format": "float"
                    }
                  ]
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Bilinear"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Distance": {
              "type": "array",
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Distance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Angular": {
              "type": "array",
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Angular"
          ]
        }
      ]
    },
    "Decoration": {
      "description": "A blueprint decoration entry. Follows the old convention of carrying\n`svg_id`/`path_id`, plus the decoration-specific [`DecorationConfig`].",
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/$defs/DecorationConfig"
        },
        "path_id": {
          "type": "string"
        },
        "svg_id": {
          "type": "string"
        }
      },
      "required": [
        "svg_id",
        "path_id",
        "config"
      ]
    },
    "DecorationAnchorMode": {
      "description": "How a cosmetic decoration follows the frame of its host body part each frame.",
      "oneOf": [
        {
          "description": "Rigid parallelogram affine (R1): shape + frame scale follow.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "rigid"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "Rigid orientation-follow (R2): rotation follows, constant size. Default.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "rigid_rotation"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "Bilinear shear-follow: uses all four frame corners.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "bilinear"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "DecorationConfig": {
      "description": "Decoration-specific blueprint data: which body part it attaches to and how it\nanchors to that part's frame. Offset/uv values are derived at load time from\nthe drawn AABB, so they are not stored here.",
      "type": "object",
      "properties": {
        "anchor": {
          "description": "Anchor mode (defaults to `RigidRotation` when omitted).",
          "$ref": "#/$defs/DecorationAnchorMode",
          "default": {
            "mode": "rigid_rotation"
          }
        },
        "host": {
          "description": "Name of the host body part (`path_id` of the collider it rides).",
          "type": "string"
        }
      },
      "required": [
        "host"
      ]
    },
    "FrameInitConfig": {
      "type": "object",
      "properties": {
        "frame_particles_damping": {
          "type": "number",
          "format": "float"
        },
        "left_hip": {
          "type": "string"
        },
        "right_hip": {
          "type": "string"
        },
        "spine_base": {
          "type": "string"
        },
        "spine_mid": {
          "type": "string"
        }
      },
      "required": [
        "left_hip",
        "right_hip",
        "spine_base",
        "spine_mid",
        "frame_particles_damping"
      ]
    },
    "FramePositionConstraintConfig": {
      "type": "object",
      "properties": {
        "compliance": {
          "type": "number",
          "format": "float"
        },
        "damping": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "compliance",
        "damping"
      ]
    },
    "JointConfig": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/$defs/ConnectionInitConfig"
        },
        "path_id": {
          "type": "string"
        },
        "svg_id": {
          "type": "string"
        }
      },
      "required": [
        "svg_id",
        "path_id",
        "config"
      ]
    },
    "Particle": {
      "type": "object",
      "properties": {
        "inv_mass": {
          "type": "number",
          "format": "float"
        },
        "pos": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "pos",
        "inv_mass"
      ]
    },
    "ParticleConfig": {
      "type": "object",
      "properties": {
        "frame_conn": {
          "$ref": "#/$defs/FramePositionConstraintConfig"
        },
        "particle": {
          "$ref": "#/$defs/Particle"
        },
        "path_id": {
          "type": "string"
        },
        "svg_id": {
          "type": "string"
        }
      },
      "required": [
        "svg_id",
        "path_id",
        "particle",
        "frame_conn"
      ]
    },
    "ShapeMatchingConfig": {
      "type": "object",
      "properties": {
        "init_config": {
          "$ref": "#/$defs/FrameInitConfig"
        },
        "path_id": {
          "type": "string"
        },
        "svg_id": {
          "type": "string"
        }
      },
      "required": [
        "svg_id",
        "path_id",
        "init_config"
      ]
    },
    "SoftBodyInitConfig": {
      "type": "object",
      "properties": {
        "bilinear_constraints_scaler": {
          "type": "number",
          "format": "float"
        },
        "frame_constraints_scaler": {
          "type": "number",
          "format": "float"
        },
        "inner_constraints_scaler": {
          "type": "number",
          "format": "float"
        },
        "max_complexity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "resititution": {
          "type": "number",
          "format": "float"
        },
        "self_collision_complaince": {
          "type": "number",
          "format": "float"
        },
        "self_collision_distance_threhold": {
          "type": "number",
          "format": "float"
        },
        "shape_matching_damping": {
          "type": "number",
          "format": "float"
        },
        "substeps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total_inv_mass": {
          "type": "number",
          "format": "float"
        },
        "velocity_against_nromal_damping_threhold": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "max_complexity",
        "resititution",
        "velocity_against_nromal_damping_threhold",
        "total_inv_mass",
        "inner_constraints_scaler",
        "bilinear_constraints_scaler",
        "frame_constraints_scaler",
        "substeps",
        "self_collision_complaince",
        "self_collision_distance_threhold",
        "shape_matching_damping"
      ]
    }
  }
}